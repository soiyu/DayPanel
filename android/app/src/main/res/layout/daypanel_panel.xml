<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/panel_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_light">
 <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/panel_date" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="DayPanel" android:textSize="13sp" android:textColor="#18223B" android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/panel_settings" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="···" android:textSize="24sp" android:textColor="#637089" />
 </LinearLayout>
 <LinearLayout android:id="@+id/panel_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
 <TextView android:id="@+id/panel_footer" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:textSize="12sp" android:textColor="#637089" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>