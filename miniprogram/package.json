{
  "name": "daypanel-miniprogram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DayPanel WeChat mini program (uni-app, cloud-first)",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "audit:size": "node scripts/audit-size.mjs",
    "build:cloud": "node scripts/build-cloud.mjs",
    "prepare:wechat": "node scripts/prepare-wechat-project.mjs",
    "verify": "npm run typecheck && npm test && npm run build:mp-weixin && npm run build:cloud && npm run prepare:wechat && npm run audit:size"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5030620261112001",
    "@dcloudio/uni-components": "3.0.0-alpha-5030620261112001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5030620261112001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5030620261112001",
    "pinia": "4.1.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5030620261112001",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vite": "5.2.8"
  }
}
